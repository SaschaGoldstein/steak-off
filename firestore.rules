rules_version = '2';
// Gastheer: Sascha
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'HXDG4pE0ZgbTtkJyQldpNgVIJmz1'; }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }

    // Fase van de avond en de uitslag: iedereen leest, alleen Sascha schrijft
    match /event/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Spelers: iedereen ziet de lijst, je past alleen je eigen inschrijving aan
    match /guests/{id} {
      allow read: if true;
      allow write: if isSelf(id) || isOwner();
    }
    // E-mailadressen: alleen jezelf en Sascha
    match /contacts/{id} {
      allow read, write: if isSelf(id) || isOwner();
    }
    // Ingecheckt stuk vlees: geheim tot de onthulling (alleen jezelf en Sascha)
    match /pieces/{id} {
      allow read, write: if isSelf(id) || isOwner();
    }
    // Geheime nummers: iedereen leest, je claimt een vrij nummer voor jezelf
    match /nummers/{n} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner();
    }
    // Scores: iedereen leest (voor de uitslag), je schrijft alleen je eigen kaart
    match /scores/{id} {
      allow read: if true;
      allow write: if isSelf(id) || isOwner();
    }
  }
}
